# Cadena privada de MongoDB Atlas o de otro servidor MongoDB compatible.
MONGODB_URI=

# Clave privada de Resend. Nunca uses el prefijo NEXT_PUBLIC_ para esta variable.
RESEND_API_KEY=
# onboarding@resend.dev sirve para pruebas; usa un dominio verificado en producción.
RESEND_FROM_EMAIL="Rubén Palomo <onboarding@resend.dev>"
# Dirección privada que recibirá los mensajes y avisos de suscripciones confirmadas.
RESEND_NOTIFICATION_EMAIL=ruben.palomof@gmail.com

# URL pública HTTPS utilizada en los enlaces de confirmación enviados por email.
NEXT_PUBLIC_SITE_URL=https://rubenpalomo.vercel.app
